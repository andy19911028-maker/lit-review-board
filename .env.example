# 複製此檔案為 .env.local 並填入以下設定
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 阿里雲百煉 DashScope（OpenAI 相容模式）
# https://bailian.console.aliyun.com/ > API-KEY 管理
AI_API_KEY=sk-...

# 注意：北京站與新加坡站的 API Key 不能互用，用錯會回 401 invalid_api_key
# 中國大陸帳號（北京站）：
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 國際帳號（新加坡站）改用：
# AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 功能一（PDF 解析）功能二（分析文獻）功能四（生成假設）：純文字模型
AI_MODEL_TEXT=qwen-plus
# 功能三（解析模型圖）：視覺模型
AI_MODEL_VISION=qwen3-vl-plus
